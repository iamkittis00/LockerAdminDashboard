# Database
DB_HOST=localhost
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=changeme

# JWT Auth
# ต้องยาวอย่างน้อย 32 ตัว สร้างด้วย:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# อายุ session สูงสุด (ชั่วโมง) เปิดค้างเกินนี้ต้องล็อกอินใหม่ — ไม่ใส่ = 24
SESSION_MAX_HOURS=24

# MQTT Broker
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme
# หัวข้อสั่งเปิดตู้ {station_id} ถูกแทนด้วยเลขสาขาตอนส่งจริง
# payload: {"box_number": 5, "staff_id": 1, "staff_name": "สมชาย"}
# ต้องตรงกับที่เฟิร์มแวร์ฝั่งตู้ subscribe ไว้
MQTT_UNLOCK_TOPIC=locker/{station_id}/web/unlock
# รอ broker ตอบรับกี่วินาทีก่อนถือว่าส่งไม่สำเร็จ — ไม่ใส่ = 5
MQTT_PUBLISH_TIMEOUT_SECONDS=5

# API Server
# 127.0.0.1 = รับเฉพาะจาก nginx บนเครื่องเดียวกัน (คนนอกยิงเข้าพอร์ตตรงๆ ไม่ได้)
API_HOST=127.0.0.1
API_PORT=8885
ALLOWED_ORIGINS=https://locker-admin.donaus-dev.net

# กัน brute force ตอน login (นับแยกตาม username + IP)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
