# Database
DB_HOST=localhost
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=changeme

# JWT Auth
# ต้องยาวอย่างน้อย 32 ตัว สร้างด้วย:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# MQTT Broker
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme

# API Server
# 127.0.0.1 = รับเฉพาะจาก nginx บนเครื่องเดียวกัน (คนนอกยิงเข้าพอร์ตตรงๆ ไม่ได้)
API_HOST=127.0.0.1
API_PORT=8885
ALLOWED_ORIGINS=https://locker-admin.donaus-dev.net

# กัน brute force ตอน login (นับแยกตาม username + IP)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
